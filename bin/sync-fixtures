#!/usr/bin/env php
<?php

/**
 * Copies the feeds the tests use from the test-data repository
 * (1994limited/ingest-statamic-test-data) into tests/__fixtures__/feeds.
 *
 *   bin/sync-fixtures                       # from ../ingest-statamic-test-data
 *   bin/sync-fixtures /path/to/test-data
 *
 * The tests never fetch over the network: they read these copies through
 * Http::fake(). Re-run this after changing the test data, and commit.
 */

$source = rtrim($argv[1] ?? dirname(__DIR__, 2).'/ingest-statamic-test-data', '/');
$target = dirname(__DIR__).'/tests/__fixtures__/feeds';

if (! is_dir($source.'/books')) {
    fwrite(STDERR, "No test data at {$source}. Clone 1994limited/ingest-statamic-test-data next to this repository, or pass its path.\n");
    exit(1);
}

$skip = [
    // One of each "show" endpoint is enough.
    '#^books/show/(?!9791001000373)#',
    '#^events/show/(?!evt_)#',
    '#^generator/#',
    '#^\.#',
    '#^(README|LICENSE)#',
];

exec('rm -rf '.escapeshellarg($target));
$copied = 0;

$files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($source, FilesystemIterator::SKIP_DOTS));
foreach ($files as $file) {
    $relative = substr($file->getPathname(), strlen($source) + 1);

    foreach ($skip as $pattern) {
        if (preg_match($pattern, $relative)) {
            continue 2;
        }
    }

    if (str_starts_with($relative, 'events/show/') && $copied > 0 && glob($target.'/events/show/*')) {
        continue;
    }

    @mkdir(dirname($target.'/'.$relative), 0755, true);
    copy($file->getPathname(), $target.'/'.$relative);
    $copied++;
}

echo "Copied {$copied} files to tests/__fixtures__/feeds.\n";
